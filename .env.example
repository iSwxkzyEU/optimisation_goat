# Copie ce fichier en ".env" et remplis les valeurs (le .env est ignoré par git).

# Discord Developer Portal → General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal → onglet Bot → Reset Token (SECRET)
DISCORD_BOT_TOKEN=

# Optionnel : enregistrement instantané de /id sur ton serveur
DISCORD_GUILD_ID=

# Optionnel : surcharge Supabase (sinon valeurs publiques par défaut)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
